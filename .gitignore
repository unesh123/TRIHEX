# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.exe
cursor-hook-test.txt
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.local
.env.production
.env.development
.env.*.local
.env*

# vercel
.vercel

# private / sensitive local assets
/private/
/secrets/
**/payment-proofs/
**/payment-qr/
**/authorization-docs/
**/*bank*screenshot*
**/*siddhartha*

# typescript
*.tsbuildinfo
next-env.d.ts

# database backups
data/backups/
*.zip
*.docx
/*.png

# handover packages and internal pricing matrices
trihex_handover_package/
TRIHEX_30_INDIVIDUAL_PRODUCT_IMAGES/
*HANDOVER*
*CHECKLIST*
AGENT_IMPLEMENTATION_PROMPT*
*review_matrix*
